{
    "preset": "laravel",
    "rules": {
        "concat_space": {
            "spacing": "one"
        },
        "declare_equal_normalize": {
            "space": "single"
        },
        "binary_operator_spaces": {
            "operators": {
                "=>": "align",
                "=": "align"
            }
        },
        "not_operator_with_successor_space": false,
        "class_attributes_separation": {
            "elements": {
                "method": "one",
                "const": "only_if_meta"
            },
            "skip_single_line_classes": true
        },
        "elseif": true,
        "control_structure_continuation_position": {
            "position": "next_line"
        },
        "braces_position": {
            "functions_opening_brace": "next_line"
        },
        "phpdoc_align": {
            "align": "vertical"
        },
        "phpdoc_separation": {
            "groups": [
                [
                    "param"
                ]
            ]
        },
        "php_unit_method_casing": {
            "case": "camel_case"
        },
        "new_with_parentheses": {
            "anonymous_class": false,
            "named_class": true
        },
        "type_declaration_spaces": {
            "elements": [
                "property"
            ]
        }
    }
}